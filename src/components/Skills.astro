---
import { SKILLS } from '../data/constants';
import { CodeBracketIcon, CubeTransparentIcon } from './icons';

const groups = [
  { title: 'Languages & Frameworks', Icon: CodeBracketIcon, skills: SKILLS['Languages & Frameworks'] },
  { title: '3D & Simulation', Icon: CubeTransparentIcon, skills: SKILLS['3D & Simulation'] },
  { title: 'Databases & Cloud', Icon: CodeBracketIcon, skills: [...SKILLS['Databases'], ...SKILLS['Cloud & DevOps']] },
];
---

<section id="skills" class="reveal py-16 px-4 max-w-4xl mx-auto">
  <h2 class="text-3xl font-bold text-[#1e3a8a] text-center mb-10">Technical Skills</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {groups.map(({ title, Icon, skills }) => (
      <div class="bg-white rounded-xl shadow-xs border border-slate-100 p-6">
        <div class="flex items-center gap-3 mb-6">
          <Icon className="w-6 h-6 text-slate-800" />
          <h3 class="text-xl font-bold text-slate-900">{title}</h3>
        </div>
        <ul class="flex flex-wrap gap-2">
          {skills.map((skill) => (
            <li class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-sm font-medium">
              {skill.name}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
