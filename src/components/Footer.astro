---
import { PERSONAL_INFO } from '../data/constants';
import { GithubIcon, LinkedinIcon, MailIcon } from './icons';

const social = (name: string) => PERSONAL_INFO.socials.find((s) => s.name === name)?.url;
// Rendered at build time; the site is rebuilt on every deploy.
const year = new Date().getFullYear();
---

<footer id="contact" class="reveal reveal-fade py-16 text-center bg-[#f8fafc] mt-16">
  <h2 class="text-3xl font-bold text-[#003366] mb-4">Get In Touch</h2>
  <p class="text-slate-500 mb-8 max-w-md mx-auto text-lg">
    I'm currently seeking new opportunities. Feel free to reach out!
  </p>
  <a href={`mailto:${PERSONAL_INFO.email}`} class="inline-block bg-[#003366] text-white font-bold py-3 px-10 rounded-lg hover:bg-[#002244] transition-colors mb-10 text-lg">
    {PERSONAL_INFO.email}
  </a>

  <div class="flex justify-center gap-6 mb-8">
    <a href={social('GitHub')} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-slate-500 hover:text-slate-900 transition-colors">
      <GithubIcon className="w-8 h-8" />
    </a>
    <a href={social('LinkedIn')} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-slate-500 hover:text-[#0077b5] transition-colors">
      <LinkedinIcon className="w-8 h-8" />
    </a>
    <a href={social('Email')} aria-label="Email" class="text-slate-500 hover:text-slate-900 transition-colors">
      <MailIcon className="w-8 h-8" />
    </a>
  </div>

  <p class="text-slate-400 text-sm">
    © {year} {PERSONAL_INFO.name}. All rights reserved.
  </p>
</footer>
