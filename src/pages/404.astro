---
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <NavBar />
  <main class="pt-40 pb-16 px-4 text-center">
    <p class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-3">404</p>
    <h1 class="text-4xl md:text-5xl font-extrabold text-[#1e3a8a] mb-4 tracking-tight">Page not found</h1>
    <p class="text-lg text-slate-500 mb-10 max-w-md mx-auto">
      The page you're looking for doesn't exist or has moved.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-block bg-[#003366] text-white font-bold py-3 px-8 rounded-lg hover:bg-[#002244] transition-colors">
        Go to the home page
      </a>
      <a href="/#projects" class="inline-block bg-white border border-slate-200 text-slate-800 font-bold py-3 px-8 rounded-lg hover:bg-slate-50 transition-colors">
        See projects
      </a>
    </div>
  </main>
  <Footer />
</Base>
